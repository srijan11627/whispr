# Copy to .env and fill in. NEVER commit a real .env.
PORT=5000
JWT_SECRET=change-this-to-a-long-random-string

# --- Database ---
# Local (default, zero-config — just run it, no account needed):
#   leave this commented out or set it explicitly:
# DATABASE_URL=file:./data/whispr.db
#
# Production on Turso (free tier, no credit card — see DEPLOY.md):
# DATABASE_URL=libsql://your-db-username.turso.io
# DATABASE_AUTH_TOKEN=paste-token-from-turso-db-tokens-create

# Comma-separated list of allowed CORS origins (the client URL).
# Recommended: *  (allows the served client from any origin — LAN phones, Render URL, etc.
# Auth is JWT-based, not cookies, so this is safe for a private friends app.)
# Or list exact origins: http://localhost:5173,https://whispr-ab12.onrender.com
CLIENT_URL=*
